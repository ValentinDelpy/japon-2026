{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/seed.json", "/icons/**", "/fonts/**", "/**/*.(png|jpg|jpeg|svg|webp|gif|ico)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "supabase-api",
      "urls": ["https://*.supabase.co/rest/v1/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 200, "maxAge": "1d", "timeout": "6s" }
    },
    {
      "name": "images-cdn",
      "urls": ["https://images.unsplash.com/**", "https://upload.wikimedia.org/**", "https://server.arcgisonline.com/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 200, "maxAge": "7d" }
    }
  ]
}
